# Salin file ini menjadi .env.local dan isi dengan nilai dari Supabase
# project "Himasal Probolinggo" (Project Settings > API).
# JANGAN PERNAH mengisi nilai dari project Supabase RuangBerita.
# JANGAN commit file .env.local (sudah di-ignore lewat .gitignore).

# Public - aman diekspos ke browser (dilindungi oleh Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only - JANGAN pernah diberi prefix NEXT_PUBLIC_, jangan diekspos ke
# client bundle. Dipakai untuk operasi admin (mis. membuat akun alumni,
# generate QR) lewat Server Action/Route Handler.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL aplikasi, dipakai untuk membangun link (reset password, undangan
# akun, dsb). Untuk lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
