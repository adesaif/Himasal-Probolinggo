{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nama project Cloudflare Workers. HARUS "himasal-probolinggo" dan tidak
  // boleh diarahkan ke project Cloudflare lain (mis. RuangBerita).
  "name": "himasal-probolinggo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler menjalankan perintah ini secara otomatis sebelum `wrangler
  // deploy`/`wrangler dev` (dan sebelum membaca "main"/"assets.directory"
  // di bawah). Ini WAJIB ada supaya deployment Cloudflare Workers Builds
  // yang hanya menjalankan `npx wrangler deploy` (tanpa build step
  // terpisah) tetap menghasilkan `.open-next/` lebih dulu - tanpa ini,
  // wrangler tidak menemukan direktori assets apa pun ("Could not detect
  // a directory containing static files") karena `.open-next/` memang
  // belum pernah dibuat.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, dll) TIDAK didefinisikan di sini.
  // Set lewat `wrangler secret put <NAME>` atau dashboard Cloudflare, dan
  // NEXT_PUBLIC_* lewat `wrangler.jsonc` "vars" hanya untuk nilai non-rahasia
  // jika diperlukan saat build produksi (lihat README bagian Cloudflare).
}
